---
import "../styles/global.css";

interface Props {
    title?: string;
    description?: string;
}

const {
    title = "KDE KeyCast",
    description = "A keyboard and mouse visualizer for KDE Plasma on Wayland.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <meta name="generator" content={Astro.generator} />
        <meta name="description" content={description} />
        <meta name="theme-color" content="#0f172a" />
        <title>{title}</title>
        <link
            rel="icon"
            type="image/svg+xml"
            href={`${import.meta.env.BASE_URL}/favicon.svg`}
        />
    </head>
    <body>
        <slot />
    </body>
</html>
