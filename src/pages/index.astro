---
import Layout from "../layouts/Layout.astro";
---

<Layout>
    <main class="relative isolate flex min-h-screen flex-col overflow-hidden bg-[#080d19] text-white">
        <!-- Background effects -->
        <div class="pointer-events-none absolute inset-0 -z-10 overflow-hidden">
            <div class="absolute -top-48 left-1/2 h-[600px] w-[600px] -translate-x-1/2 rounded-full bg-blue-600/20 blur-[140px]"></div>
            <div class="absolute -bottom-64 -right-40 h-[500px] w-[500px] rounded-full bg-violet-600/10 blur-[130px]"></div>
            <div class="absolute inset-0 bg-[radial-gradient(#ffffff08_1px,transparent_1px)] [background-size:32px_32px]"></div>
        </div>

        <!-- Navigation -->
        <header class="mx-auto flex w-full max-w-7xl items-center justify-between px-6 py-7 lg:px-10">
            <a href="/" class="flex items-center gap-3">
                <img
                    src="/images/keycast-light.svg"
                    alt="KDE KeyCast"
                    class="h-10 w-10"
                />
                <span class="text-lg font-semibold tracking-tight">
                    KDE KeyCast
                </span>
            </a>

            <nav class="hidden items-center gap-8 text-sm text-slate-400 md:flex">
                <a href="#features" class="transition hover:text-white">
                    Features
                </a>
                <a href="#installation" class="transition hover:text-white">
                    Installation
                </a>
                <a
                    href="https://github.com/hgmarcury/kde-keycast"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="transition hover:text-white"
                >
                    GitHub ↗
                </a>
            </nav>
        </header>

        <!-- Hero -->
        <section class="mx-auto flex w-full max-w-7xl flex-1 flex-col items-center justify-center px-6 pb-28 pt-16 text-center lg:px-10">
            <div class="mb-8 inline-flex items-center gap-2 rounded-full border border-blue-400/20 bg-blue-400/5 px-4 py-2 text-xs font-medium tracking-wide text-blue-300">
                <span class="h-2 w-2 rounded-full bg-blue-400 shadow-[0_0_12px_#60a5fa]"></span>
                Built for KDE Plasma · Wayland
            </div>

            <div class="relative mb-9">
                <div class="absolute inset-0 scale-150 rounded-full bg-blue-500/20 blur-3xl"></div>
                <img
                    src="/images/keycast-light.svg"
                    alt=""
                    class="relative h-28 w-28 drop-shadow-[0_0_35px_rgba(96,165,250,0.25)] sm:h-36 sm:w-36"
                />
            </div>

            <h1 class="max-w-4xl text-5xl font-bold tracking-tight sm:text-6xl lg:text-7xl">
                Make every keystroke
                <span class="block bg-gradient-to-r from-blue-400 via-cyan-300 to-violet-400 bg-clip-text text-transparent">
                    visible.
                </span>
            </h1>

            <p class="mt-7 max-w-2xl text-base leading-8 text-slate-400 sm:text-lg">
                A lightweight keyboard and mouse visualizer for KDE Plasma on
                Wayland. Show your keystrokes, mouse buttons and scroll wheel in
                real time.
            </p>

            <div class="mt-10 flex w-full flex-col justify-center gap-4 sm:w-auto sm:flex-row">
                <a
                    href="https://github.com/hgmarcury/kde-keycast/releases/latest"
                    class="inline-flex items-center justify-center gap-3 rounded-xl bg-blue-500 px-7 py-4 text-sm font-semibold text-white shadow-lg shadow-blue-500/20 transition hover:-translate-y-0.5 hover:bg-blue-400 hover:shadow-blue-400/30"
                >
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        class="h-5 w-5"
                    >
                        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
                        <path d="m7 10 5 5 5-5" />
                        <path d="M12 15V3" />
                    </svg>
                    Download latest release
                </a>

                <a
                    href="https://github.com/hgmarcury/kde-keycast"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center justify-center gap-3 rounded-xl border border-white/10 bg-white/5 px-7 py-4 text-sm font-semibold text-slate-200 backdrop-blur transition hover:-translate-y-0.5 hover:border-white/20 hover:bg-white/10"
                >
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        viewBox="0 0 24 24"
                        fill="currentColor"
                        class="h-5 w-5"
                    >
                        <path
                            fill-rule="evenodd"
                            d="M12 2C6.477 2 2 6.477 2 12c0 4.418 2.865 8.166 6.839 9.489.5.092.682-.217.682-.482 0-.237-.009-.866-.014-1.7-2.782.604-3.369-1.341-3.369-1.341-.455-1.155-1.11-1.463-1.11-1.463-.908-.62.069-.608.069-.608 1.003.07 1.531 1.03 1.531 1.03.892 1.53 2.341 1.088 2.91.832.092-.646.35-1.088.636-1.338-2.22-.253-4.555-1.11-4.555-4.944 0-1.091.39-1.984 1.03-2.683-.103-.253-.447-1.27.098-2.647 0 0 .84-.269 2.75 1.025A9.56 9.56 0 0 1 12 6.836c.85.004 1.705.115 2.504.337 1.909-1.294 2.747-1.025 2.747-1.025.547 1.377.203 2.394.1 2.647.64.699 1.028 1.592 1.028 2.683 0 3.844-2.339 4.688-4.566 4.936.359.309.678.92.678 1.854 0 1.338-.012 2.419-.012 2.75 0 .267.18.579.688.48C19.138 20.163 22 16.416 22 12c0-5.523-4.477-10-10-10Z"
                            clip-rule="evenodd"
                        />
                    </svg>
                    Explore on GitHub
                </a>
            </div>

            <p class="mt-6 text-xs text-slate-500">
                Free · Open source · GPL-3.0-or-later
            </p>
        </section>
        <!-- Features -->
        <section
            id="features"
            class="relative border-t border-white/5 bg-white/[0.015] px-6 py-28 lg:px-10"
        >
            <div class="mx-auto max-w-7xl">
                <div class="mx-auto mb-16 max-w-2xl text-center">
                    <span class="text-xs font-semibold uppercase tracking-[0.25em] text-blue-400">
                        Features
                    </span>
                    <h2 class="mt-5 text-3xl font-bold tracking-tight sm:text-4xl">
                        More than just{" "}
                        <span class="text-cyan-300">keystrokes.</span>
                    </h2>
                    <p class="mt-5 text-base leading-7 text-slate-400">
                        Everything you need to make your keyboard and mouse
                        activity visible, designed for KDE Plasma.
                    </p>
                </div>

                <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
                    <!-- Keyboard -->
                    <article class="group rounded-2xl border border-white/[0.08] bg-white/[0.025] p-7 transition duration-300 hover:-translate-y-1 hover:border-blue-400/30 hover:bg-blue-400/[0.04]">
                        <div class="mb-7 flex h-12 w-12 items-center justify-center rounded-xl border border-blue-400/20 bg-blue-400/10 text-blue-300 transition group-hover:bg-blue-400/15">
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="1.7"
                                class="h-6 w-6"
                            >
                                <rect
                                    x="2"
                                    y="5"
                                    width="20"
                                    height="14"
                                    rx="2"
                                />
                                <path d="M6 9h.01M10 9h.01M14 9h.01M18 9h.01M6 13h.01M10 13h.01M14 13h.01M18 13h.01M8 16h8" />
                            </svg>
                        </div>
                        <h3 class="text-lg font-semibold text-white">
                            Smart Keyboard Display
                        </h3>
                        <p class="mt-3 text-sm leading-7 text-slate-400">
                            Accurate key detection with XKB, respecting your
                            active keyboard layout, modifiers and key
                            combinations.
                        </p>
                    </article>

                    <!-- Mouse -->
                    <article class="group rounded-2xl border border-white/[0.08] bg-white/[0.025] p-7 transition duration-300 hover:-translate-y-1 hover:border-cyan-400/30 hover:bg-cyan-400/[0.04]">
                        <div class="mb-7 flex h-12 w-12 items-center justify-center rounded-xl border border-cyan-400/20 bg-cyan-400/10 text-cyan-300 transition group-hover:bg-cyan-400/15">
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="1.7"
                                class="h-6 w-6"
                            >
                                <rect
                                    x="6"
                                    y="2"
                                    width="12"
                                    height="20"
                                    rx="6"
                                />
                                <path d="M12 2v6M12 5v3" />
                            </svg>
                        </div>
                        <h3 class="text-lg font-semibold text-white">
                            Mouse Activity
                        </h3>
                        <p class="mt-3 text-sm leading-7 text-slate-400">
                            Visualize mouse button events and physical scroll
                            wheel activity alongside your keyboard input.
                        </p>
                    </article>

                    <!-- Compact mode -->
                    <article class="group rounded-2xl border border-white/[0.08] bg-white/[0.025] p-7 transition duration-300 hover:-translate-y-1 hover:border-violet-400/30 hover:bg-violet-400/[0.04]">
                        <div class="mb-7 flex h-12 w-12 items-center justify-center rounded-xl border border-violet-400/20 bg-violet-400/10 text-violet-300 transition group-hover:bg-violet-400/15">
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="1.7"
                                class="h-6 w-6"
                            >
                                <rect
                                    x="3"
                                    y="4"
                                    width="18"
                                    height="16"
                                    rx="2"
                                />
                                <path d="M7 9h3M14 9h3M7 15h10" />
                            </svg>
                        </div>
                        <h3 class="text-lg font-semibold text-white">
                            Compact Mode
                        </h3>
                        <p class="mt-3 text-sm leading-7 text-slate-400">
                            Keep your overlay clean and focused by displaying
                            only the relevant key combinations.
                        </p>
                    </article>

                    <!-- KDE -->
                    <article class="group rounded-2xl border border-white/[0.08] bg-white/[0.025] p-7 transition duration-300 hover:-translate-y-1 hover:border-fuchsia-400/30 hover:bg-fuchsia-400/[0.04]">
                        <div class="mb-7 flex h-12 w-12 items-center justify-center rounded-xl border border-fuchsia-400/20 bg-fuchsia-400/10 text-fuchsia-300 transition group-hover:bg-fuchsia-400/15">
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="1.7"
                                class="h-6 w-6"
                            >
                                <rect
                                    x="3"
                                    y="3"
                                    width="18"
                                    height="18"
                                    rx="3"
                                />
                                <path d="M3 9h18M9 21V9" />
                            </svg>
                        </div>
                        <h3 class="text-lg font-semibold text-white">
                            KDE Integration
                        </h3>
                        <p class="mt-3 text-sm leading-7 text-slate-400">
                            Designed for KDE Plasma, with a system tray icon and
                            optional KWin integration.
                        </p>
                    </article>
                </div>
            </div>
        </section>

        <!-- See it in action -->
        <section
            id="demo"
            class="relative overflow-hidden border-t border-white/5 px-6 py-28 lg:px-10"
        >
            <div class="pointer-events-none absolute -left-48 top-1/3 h-96 w-96 rounded-full bg-blue-600/10 blur-[130px]"></div>

            <div class="relative mx-auto grid max-w-7xl items-center gap-16 lg:grid-cols-2">
                <div>
                    <span class="text-xs font-semibold uppercase tracking-[0.25em] text-cyan-400">
                        See it in action
                    </span>

                    <h2 class="mt-5 text-3xl font-bold tracking-tight sm:text-4xl">
                        Your input.
                        <span class="block text-blue-300">
                            Right on screen.
                        </span>
                    </h2>

                    <p class="mt-6 max-w-xl text-base leading-8 text-slate-400">
                        KDE KeyCast makes keyboard and mouse activity visible in
                        real time. Whether you're creating tutorials, recording
                        demonstrations or sharing your workflow, your audience
                        can follow every interaction.
                    </p>

                    <div class="mt-8 flex flex-wrap gap-3">
                        <span class="rounded-full border border-white/10 bg-white/5 px-4 py-2 text-xs text-slate-300">
                            Keyboard input
                        </span>
                        <span class="rounded-full border border-white/10 bg-white/5 px-4 py-2 text-xs text-slate-300">
                            Mouse buttons
                        </span>
                        <span class="rounded-full border border-white/10 bg-white/5 px-4 py-2 text-xs text-slate-300">
                            Scroll wheel
                        </span>
                    </div>
                </div>

                <div class="relative">
                    <div class="absolute -inset-5 rounded-3xl bg-gradient-to-br from-blue-500/20 via-cyan-400/10 to-violet-500/20 opacity-70 blur-2xl"></div>

                    <div class="relative overflow-hidden rounded-2xl border border-white/10 bg-[#0d1424] p-2 shadow-2xl shadow-blue-950/40">
                        <div class="flex items-center gap-2 border-b border-white/5 px-4 py-3">
                            <span class="h-2.5 w-2.5 rounded-full bg-red-400/70"></span>
                            <span class="h-2.5 w-2.5 rounded-full bg-yellow-400/70"></span>
                            <span class="h-2.5 w-2.5 rounded-full bg-green-400/70"></span>
                            <span class="ml-3 text-xs text-slate-500">
                                KDE KeyCast · Live demo
                            </span>
                        </div>

                        <img
                            src="/images/kde-keycast-demo-crop.gif"
                            alt="Animated demonstration of KDE KeyCast displaying keyboard and mouse activity"
                            class="block h-auto w-full rounded-b-lg"
                            loading="lazy"
                        />
                    </div>
                </div>
            </div>
        </section>

        <!-- KDE Plasma integration -->
        <section
            id="plasma-integration"
            class="relative overflow-hidden border-t border-white/5 px-6 py-28 lg:px-10"
        >
            <div class="pointer-events-none absolute -right-48 top-1/4 h-96 w-96 rounded-full bg-violet-500/10 blur-[130px]"></div>

            <div class="relative mx-auto max-w-7xl">
                <div class="mx-auto mb-14 max-w-3xl text-center">
                    <span class="text-xs font-semibold uppercase tracking-[0.25em] text-cyan-400">
                        Made for your desktop
                    </span>

                    <h2 class="mt-5 text-3xl font-bold tracking-tight sm:text-4xl">
                        A natural fit for
                        <span class="text-blue-300">KDE Plasma.</span>
                    </h2>

                    <p class="mx-auto mt-6 max-w-2xl text-base leading-8 text-slate-400">
                        KDE KeyCast integrates into your Plasma desktop with a
                        system tray icon and optional KWin integration, keeping
                        your keyboard and mouse visualizer close at hand.
                    </p>
                </div>

                <div class="relative">
                    <div class="absolute -inset-5 rounded-3xl bg-gradient-to-r from-blue-500/15 via-cyan-400/10 to-violet-500/15 opacity-80 blur-2xl"></div>

                    <div class="relative overflow-hidden rounded-2xl border border-white/10 bg-[#0d1424] p-2 shadow-2xl shadow-blue-950/40">
                        <img
                            src="/images/kde-keycast.png"
                            alt="KDE KeyCast running on a KDE Plasma desktop"
                            class="block h-auto w-full rounded-xl"
                            loading="lazy"
                        />
                    </div>
                </div>

                <div class="mt-10 grid gap-6 sm:grid-cols-2">
                    <div class="rounded-2xl border border-white/5 bg-white/[0.025] p-6">
                        <h3 class="text-sm font-semibold text-white">
                            System tray integration
                        </h3>
                        <p class="mt-2 text-sm leading-7 text-slate-400">
                            Access KDE KeyCast directly from the Plasma system
                            tray.
                        </p>
                    </div>

                    <div class="rounded-2xl border border-white/5 bg-white/[0.025] p-6">
                        <h3 class="text-sm font-semibold text-white">
                            Optional KWin integration
                        </h3>
                        <p class="mt-2 text-sm leading-7 text-slate-400">
                            Add the optional KWin integration to control the
                            visualizer's always-on-top behavior.
                        </p>
                    </div>
                </div>
            </div>
        </section>

        <!-- Installation -->
        <section
            id="installation"
            class="relative overflow-hidden border-t border-white/5 bg-white/[0.015] px-6 py-28 lg:px-10"
        >
            <div class="mx-auto max-w-7xl">
                <div class="mx-auto mb-16 max-w-2xl text-center">
                    <span class="text-xs font-semibold uppercase tracking-[0.25em] text-blue-400">
                        Get started
                    </span>
                    <h2 class="mt-5 text-3xl font-bold tracking-tight sm:text-4xl">
                        Ready to get <span class="text-cyan-300">started?</span>
                    </h2>
                    <p class="mt-5 text-base leading-7 text-slate-400">
                        Choose the installation method that works best for your
                        system. KDE KeyCast is free and open source.
                    </p>
                </div>

                <div class="grid grid-cols-1 gap-7 lg:grid-cols-2">
                    <!-- Native installation -->
                    <article class="min-w-0 flex flex-col rounded-2xl border border-white/10 bg-[#0d1424] p-7 sm:p-9">
                        <div class="flex items-center gap-4">
                            <div class="flex h-12 w-12 items-center justify-center rounded-xl border border-blue-400/20 bg-blue-400/10 text-blue-300">
                                <svg
                                    xmlns="http://www.w3.org/2000/svg"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="1.7"
                                    class="h-6 w-6"
                                >
                                    <rect
                                        x="3"
                                        y="4"
                                        width="18"
                                        height="16"
                                        rx="2"
                                    />
                                    <path d="m7 9 3 3-3 3M13 15h4" />
                                </svg>
                            </div>
                            <div>
                                <h3 class="text-xl font-semibold text-white">
                                    Native installation
                                </h3>
                                <p class="mt-1 text-sm text-slate-500">
                                    Build from source
                                </p>
                            </div>
                        </div>

                        <p class="mt-7 text-sm leading-7 text-slate-400">
                            Build KDE KeyCast directly on your system using
                            CMake. Ideal for users who prefer a native system
                            installation.
                        </p>

                        <div class="mt-7 rounded-xl border border-white/5 bg-[#080d19] p-5">
                            <p class="mb-3 text-xs font-semibold uppercase tracking-wider text-slate-500">
                                Build and install
                            </p>
                            <pre class="min-w-0 max-w-full overflow-x-auto whitespace-pre text-xs leading-7 text-cyan-200"><code>git clone https://github.com/hgmarcury/kde-keycast.git
        cd kde-keycast
        cmake -S . -B build
        cmake --build build -j$(nproc)
        sudo cmake --install build --prefix /usr/local</code></pre>
                        </div>

                        <div class="mt-6 rounded-xl border border-blue-400/10 bg-blue-400/[0.04] p-4">
                            <p class="text-xs leading-6 text-slate-400">
                                Requires CMake, a C/C++ compiler, Qt 6 and the
                                relevant development libraries. Input device
                                permissions may need configuration depending on
                                your distribution.
                            </p>
                        </div>

                        <div class="mt-auto pt-8">
                            <a
                                href="https://github.com/hgmarcury/kde-keycast#dependencies"
                                target="_blank"
                                rel="noopener noreferrer"
                                class="inline-flex items-center gap-2 text-sm font-semibold text-blue-300 transition hover:text-blue-200"
                            >
                                View build dependencies and instructions
                                <span aria-hidden="true">↗</span>
                            </a>
                        </div>
                    </article>

                    <!-- AppImage -->
                    <article class="min-w-0 relative flex flex-col overflow-hidden rounded-2xl border border-blue-400/20 bg-[#0d1424] p-7 shadow-xl shadow-blue-950/20 sm:p-9">
                        <div class="pointer-events-none absolute -right-24 -top-24 h-64 w-64 rounded-full bg-blue-500/10 blur-[90px]"></div>

                        <div class="relative flex items-center gap-4">
                            <div class="flex h-12 w-12 items-center justify-center rounded-xl border border-cyan-400/20 bg-cyan-400/10 text-cyan-300">
                                <svg
                                    xmlns="http://www.w3.org/2000/svg"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="1.7"
                                    class="h-6 w-6"
                                >
                                    <path d="M12 3v12m-5-5 5 5 5-5" />
                                    <path d="M5 17v3h14v-3" />
                                </svg>
                            </div>
                            <div>
                                <h3 class="text-xl font-semibold text-white">
                                    AppImage
                                </h3>
                                <p class="mt-1 text-sm text-cyan-300">
                                    Ready to run
                                </p>
                            </div>
                        </div>

                        <p class="relative mt-7 text-sm leading-7 text-slate-400">
                            Download the prebuilt application and run it on your
                            Linux system without compiling the source code.
                        </p>

                        <div class="relative mt-7 rounded-xl border border-white/5 bg-[#080d19] p-5">
                            <p class="mb-3 text-xs font-semibold uppercase tracking-wider text-slate-500">
                                Make executable and run
                            </p>
                            <pre class="min-w-0 max-w-full overflow-x-auto whitespace-pre text-xs leading-7 text-cyan-200"><code>chmod +x kde-keycast-x86_64.AppImage
        ./kde-keycast-x86_64.AppImage</code></pre>

                            <p class="mb-3 mt-6 text-xs font-semibold uppercase tracking-wider text-slate-500">
                                Optional desktop integration
                            </p>
                            <pre class="overflow-x-auto whitespace-pre text-xs leading-7 text-cyan-200"><code>./kde-keycast-x86_64.AppImage --install</code></pre>
                        </div>

                        <div class="relative mt-6 rounded-xl border border-cyan-400/10 bg-cyan-400/[0.04] p-4">
                            <p class="text-xs leading-6 text-slate-400">
                                The installer adds the desktop launcher and
                                application icons. KWin integration and input
                                permissions are configured separately when
                                needed.
                            </p>
                        </div>

                        <div class="relative mt-auto pt-8">
                            <a
                                href="https://github.com/hgmarcury/kde-keycast/releases/latest"
                                target="_blank"
                                rel="noopener noreferrer"
                                class="inline-flex w-full items-center justify-center gap-3 rounded-xl bg-blue-500 px-6 py-4 text-sm font-semibold text-white shadow-lg shadow-blue-500/20 transition hover:-translate-y-0.5 hover:bg-blue-400"
                            >
                                Download AppImage
                                <span aria-hidden="true">↓</span>
                            </a>
                        </div>
                    </article>
                </div>

                <p class="mt-10 text-center text-xs leading-6 text-slate-500">
                    Need help? Visit the
                    <a
                        href="https://github.com/hgmarcury/kde-keycast"
                        class="text-slate-300 underline decoration-white/20 underline-offset-4 transition hover:text-white"
                    >
                        GitHub repository
                    </a>
                    for complete documentation, troubleshooting and support.
                </p>
            </div>
        </section>

        <!-- About the project -->
        <section
            id="about"
            class="relative overflow-hidden border-t border-white/5 bg-white/[0.015] px-6 py-24 lg:px-10"
        >
